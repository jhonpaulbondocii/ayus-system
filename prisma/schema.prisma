generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Conversation {
  id           String                    @id @default(cuid())
  subject      String
  scope        MessageScope              @default(DIRECT)
  courseId     String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  course       Course?                   @relation(fields: [courseId], references: [id])
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  isAuthor       Boolean      @default(false)
  deletedAt      DateTime?
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  attachments    MessageAttachment[]
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  name      String
  url       String
  size      Int?
  mimeType  String?
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model User {
  id                                        String                    @id @default(cuid())
  name                                      String
  email                                     String                    @unique
  emailVerified                             DateTime?
  password                                  String?
  image                                     String?
  role                                      Role                      @default(STAFF)
  status                                    ApprovalStatus            @default(PENDING)
  department                                String?
  position                                  String?
  createdAt                                 DateTime                  @default(now())
  updatedAt                                 DateTime                  @updatedAt
  bio                                       String?
  pronouns                                  String?
  contactNumber                             String?
  employmentStatus                          String?
  accountType                               String?
  librarySignature                          String?
  accounts                                  Account[]
  activityLogs                              ActivityLog[]
  conversationParticipants                  ConversationParticipant[]
  enrollments                               CourseEnrollment[]
  formSubmissions                           FormSubmission[]
  formsCreated                              Form[]                    @relation("FormAuthor")
  groupMembers                              GroupMember[]
  medicalExamRecords                        MedicalExamRecord[]       @relation("MedExamRecordedBy")
  sentMessages                              Message[]
  resetTokens                               PasswordResetToken[]
  patientRecords                            PatientRecord[]           @relation("RecordedBy")
  quizAttempts                              QuizAttempt[]
  quizzesCreated                            Quiz[]                    @relation("QuizAuthor")
  repositoryFiles                           RepositoryFile[]
  sessions                                  Session[]
  announcementReads                         AnnouncementRead[]
  guidanceLogEntries                        GuidanceLogEntry[]        @relation("GuidanceLogRecordedBy")
  exitInterviewsCounseled                   ExitInterview[]           @relation("ExitInterviewCounselor")
  submissions_submissions_gradedByIdTousers Submission[]              @relation("submissions_gradedByIdTousers")
  submissions                               Submission[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String
  via       String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Course {
  id                   String                @id @default(cuid())
  name                 String
  code                 String                @unique
  color                String                @default("#cc2a27")
  status               CourseStatus          @default(UNPUBLISHED)
  description          String?
  term                 String?
  startDate            DateTime?
  endDate              DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  image                String?
  officeType           String?
  announcements        Announcement[]
  assignments          Assignment[]
  conversations        Conversation[]
  enrollments          CourseEnrollment[]
  forms                Form[]
  groupSets            GroupSet[]
  groups               Group[]
  medicalExamRecords   MedicalExamRecord[]
  medicineInventory    MedicineInventory[]
  patientRecords       PatientRecord[]
  quizzes              Quiz[]
  bodySystems          BodySystem[]
  medicalConditions    MedicalCondition[]
  guidanceInfoSheets   GuidanceInfoSheet[]
  guidanceLogEntries   GuidanceLogEntry[]
  exitInterviews       ExitInterview[]
  libraryCardRequests  LibraryCardRequest[]
  libraryReceivingLogs LibraryReceivingLog[]
  LibraryBook          LibraryBook[]
  LibraryBorrowRecord  LibraryBorrowRecord[]

  @@map("courses")
}

model CourseEnrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  createdAt  DateTime @default(now())
  courseRole String   @default("Student")
  section    String?
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_enrollments")
}

model GroupSet {
  id                 String   @id @default(cuid())
  name               String
  courseId           String
  selfSignUp         Boolean  @default(false)
  requireSameSection Boolean  @default(false)
  groupStructure     String   @default("Create groups later")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  autoAssignLeader   Boolean  @default(false)
  createGroupsNow    Int      @default(0)
  leaderType         String   @default("first")
  limitGroupMembers  Int      @default(0)
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groups             Group[]

  @@map("group_sets")
}

model Group {
  id          String        @id @default(cuid())
  name        String
  courseId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  groupSetId  String?
  assignments Assignment[]
  members     GroupMember[]
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groupSet    GroupSet?     @relation(fields: [groupSetId], references: [id])

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  createdAt DateTime @default(now())
  isLeader  Boolean  @default(false)
  order     Int      @default(0)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("group_members")
}

model Announcement {
  id             String                   @id @default(cuid())
  courseId       String
  title          String
  bodyText       String                   @default("")
  bodyHtml       String                   @default("")
  author         String                   @default("Admin")
  assignTo       String[]                 @default([])
  allowComment   Boolean                  @default(false)
  allowLiking    Boolean                  @default(false)
  availableFrom  DateTime?
  availableUntil DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  authorId       String?
  locked         Boolean                  @default(false)
  attachments    AnnouncementAttachment[]
  reads          AnnouncementRead[]
  course         Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

model AnnouncementAttachment {
  id             String       @id @default(cuid())
  announcementId String
  name           String
  url            String
  size           Int
  mimeType       String       @default("")
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@map("announcement_attachments")
}
model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

model Assignment {
  id                  String        @id @default(cuid())
  title               String
  description         String?
  dueDate             DateTime?
  courseId            String?
  groupId             String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  assignmentGroup     String        @default("Assignments")
  availableFrom       DateTime?
  availableUntil      DateTime?
  displayGradeAs      String        @default("Points")
  points              Float         @default(0)
  status              CourseStatus  @default(UNPUBLISHED)
  submissionType      String        @default("Online")
  allowedAttempts     Int?
  anonymousGrading    Boolean       @default(false)
  doNotCount          Boolean       @default(false)
  isGroupAssignment   Boolean       @default(false)
  notifyUsers         Boolean       @default(false)
  onlineEntryOptions  String[]      @default([])
  submissionEntries   Json          @default("[]")
  peerReviewAnonymous Boolean       @default(false)
  peerReviewAssign    String        @default("manually")
  requirePeerReviews  Boolean       @default(false)
  submissionAttempts  String        @default("Unlimited")
  groupSetId          String?
  assignees           String[]      @default([])
  createdById         String?
  course              Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  groups              Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  repositories        repositories?
  rubric              Rubric?
  submissions         Submission[]

  @@map("assignments")
}

model Submission {
  id                                  String           @id @default(cuid())
  userId                              String
  assignmentId                        String
  status                              AssignmentStatus @default(PENDING)
  fileUrl                             String?
  grade                               Float?
  feedback                            String?
  submittedAt                         DateTime?
  createdAt                           DateTime         @default(now())
  updatedAt                           DateTime         @updatedAt
  comments                            String?
  textEntry                           String?
  websiteUrl                          String?
  daysLate                            Int?
  gradedAt                            DateTime?
  gradedById                          String?
  repository_files                    RepositoryFile?
  assignment                          Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  users_submissions_gradedByIdTousers User?            @relation("submissions_gradedByIdTousers", fields: [gradedById], references: [id])
  user                                User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assignmentId])
  @@map("submissions")
}

model RepositoryFile {
  id           String       @id @default(cuid())
  repositoryId String
  submissionId String?      @unique
  userId       String
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  uploadedAt   DateTime     @default(now())
  repositories repositories @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  submissions  Submission?  @relation(fields: [submissionId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("repository_files")
}

model ActivityLog {
  id           String        @id @default(cuid())
  repositoryId String?
  userId       String
  action       String
  targetType   String?
  targetId     String?
  targetName   String?
  metadata     Json?
  createdAt    DateTime      @default(now())
  repositories repositories? @relation(fields: [repositoryId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Quiz {
  id                          String         @id @default(cuid())
  courseId                    String
  title                       String
  description                 String?
  quizType                    QuizType       @default(GRADED_QUIZ)
  assignmentGroup             String         @default("Assignments")
  points                      Float          @default(0)
  shuffleAnswers              Boolean        @default(false)
  timeLimit                   Int?
  allowMultipleAttempts       Boolean        @default(false)
  attemptLimit                Int?
  scoreToKeep                 String         @default("highest")
  viewResponses               Boolean        @default(true)
  onlyOnceAfterAttempt        Boolean        @default(false)
  showCorrectAnswers          Boolean        @default(true)
  showCorrectAnswersAt        DateTime?
  hideCorrectAnswersAt        DateTime?
  showOneAtATime              Boolean        @default(false)
  lockQuestionsAfterAnswering Boolean        @default(false)
  accessCode                  String?
  ipFilter                    String?
  assignTo                    String[]       @default([])
  dueDate                     DateTime?
  availableFrom               DateTime?
  availableUntil              DateTime?
  published                   Boolean        @default(false)
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  authorId                    String?
  authorName                  String         @default("Admin")
  authorRole                  String         @default("Admin")
  attempts                    QuizAttempt[]
  questions                   QuizQuestion[]
  author                      User?          @relation("QuizAuthor", fields: [authorId], references: [id])
  course                      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("quizzes")
}

model QuizQuestion {
  id               String             @id @default(cuid())
  quizId           String
  type             QuizQuestionType   @default(MULTIPLE_CHOICE)
  question         String
  points           Float              @default(1)
  correctAnswer    String?
  order            Int                @default(0)
  createdAt        DateTime           @default(now())
  description      String?
  quiz_answers     quiz_answers[]
  quiz_match_pairs quiz_match_pairs[]
  quiz             Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model QuizAttempt {
  id              String   @id @default(cuid())
  quizId          String
  userId          String
  score           Float    @default(0)
  durationSeconds Int      @default(0)
  submittedAt     DateTime @default(now())
  answers         Json     @default("{}")
  quiz            Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model Form {
  id                          String           @id @default(cuid())
  courseId                    String
  title                       String
  description                 String?
  formType                    FormType         @default(SURVEY_FEEDBACK)
  assignmentGroup             String           @default("Assignments")
  points                      Float            @default(0)
  shuffleAnswers              Boolean          @default(false)
  allowMultipleResponses      Boolean          @default(false)
  responseLimit               Int?
  anonymousResponses          Boolean          @default(false)
  showResultsToRespondents    Boolean          @default(false)
  showOneAtATime              Boolean          @default(false)
  lockQuestionsAfterAnswering Boolean          @default(false)
  accessCode                  String?
  confirmationMessage         String?
  assignTo                    String[]         @default([])
  dueDate                     DateTime?
  dueTime                     String?
  availableFrom               DateTime?
  availableFromTime           String?
  availableUntil              DateTime?
  availableUntilTime          String?
  published                   Boolean          @default(false)
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt
  authorId                    String?
  authorName                  String           @default("Admin")
  authorRole                  String           @default("Admin")
  questions                   FormQuestion[]
  formSubmissions             FormSubmission[]
  author                      User?            @relation("FormAuthor", fields: [authorId], references: [id])
  course                      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("forms")
}

model FormQuestion {
  id                 String           @id @default(cuid())
  formId             String
  type               FormQuestionType @default(SHORT_ANSWER)
  question           String           @default("")
  description        String?
  points             Float            @default(0)
  required           Boolean          @default(false)
  image              String?
  options            String[]         @default([])
  correctAnswer      String?
  scaleMin           Int?
  scaleMax           Int?
  scaleMinLabel      String?
  scaleMaxLabel      String?
  rows               String[]         @default([])
  columns            String[]         @default([])
  sectionTitle       String?
  sectionDescription String?
  order              Int              @default(0)
  form               Form             @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_questions")
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  userId    String
  answers   Json
  score     Float    @default(0)
  createdAt DateTime @default(now())
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([formId, userId])
  @@map("form_submissions")
}

model Rubric {
  id                   String            @id @default(cuid())
  assignmentId         String            @unique
  courseId             String?
  title                String
  type                 String            @default("scale")
  ratingDisplay        String            @default("level")
  ratingOrder          String            @default("high_low")
  scoring              String            @default("scored")
  doNotPostToGradebook Boolean           @default(false)
  useForGrading        Boolean           @default(false)
  hideScoreTotal       Boolean           @default(false)
  pointsPossible       Float             @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  criteria             RubricCriterion[]
  assignment           Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("rubrics")
}

model RubricCriterion {
  id          String         @id @default(cuid())
  rubricId    String
  name        String
  description String?
  points      Float          @default(0)
  enableRange Boolean        @default(false)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  rubric      Rubric         @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  ratings     RubricRating[]

  @@map("rubric_criteria")
}

model RubricRating {
  id          String          @id @default(cuid())
  criterionId String
  points      Float           @default(0)
  name        String
  description String?
  order       Int             @default(0)
  criterion   RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@map("rubric_ratings")
}

model Student {
  id                 String              @id @default(cuid())
  studentNumber      String              @unique
  name               String
  age                Int?
  gender             String?
  department         String?
  course             String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  email              String?
  address            String?
  birthDate          DateTime?
  medicalExamRecords MedicalExamRecord[]
  patientRecords     PatientRecord[]

  @@map("students")
}

model PatientRecord {
  id                 String            @id @default(cuid())
  courseId           String
  studentId          String
  complaint          String
  temperature        Float?
  bloodPressure      String?
  pulseRate          Int?
  weight             Float?
  diagnosis          String?
  medicine           String?
  action             PatientAction
  notes              String?
  visitDate          DateTime
  recordedBy         String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  signEmailSentAt    DateTime?
  signToken          String?           @unique
  signTokenExpiresAt DateTime?
  signatureMethod    String?
  signatureUrl       String?
  signedAt           DateTime?
  bodySystemId       String?
  medicalConditionId String?
  medicineUsages     MedicineUsage[]
  course             Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  recordedByUser     User              @relation("RecordedBy", fields: [recordedBy], references: [id])
  student            Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  medicalCondition   MedicalCondition? @relation(fields: [medicalConditionId], references: [id])

  @@index([courseId])
  @@index([studentId])
  @@index([courseId, visitDate])
  @@index([signToken])
  @@map("patient_records")
}

model BodySystem {
  id         String             @id @default(cuid())
  courseId   String
  name       String
  order      Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  conditions MedicalCondition[]

  @@index([courseId])
  @@map("body_systems")
}

model MedicalCondition {
  id             String          @id @default(cuid())
  bodySystemId   String
  courseId       String
  name           String
  order          Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bodySystem     BodySystem      @relation(fields: [bodySystemId], references: [id], onDelete: Cascade)
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  patientRecords PatientRecord[]

  @@index([courseId])
  @@index([bodySystemId])
  @@map("medical_conditions")
}

model MedicalExamRecord {
  id                  String    @id @default(cuid())
  courseId            String
  studentId           String
  purpose             String
  remarks             String?
  visitDate           DateTime
  recordedBy          String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  signatureUrl        String?
  signatureMethod     String?
  signedAt            DateTime?
  signToken           String?   @unique
  signTokenExpiresAt  DateTime?
  signEmailSentAt     DateTime?
  height              Float?
  weight              Float?
  heartRate           String?
  bloodPressure       String?
  temperature         Float?
  respiratoryRate     String?
  placeOfBirth        String?
  section             String?
  physicalSigns       Json?
  isPregnant          Boolean?
  lastMenstrualPeriod String?
  civilStatus         String?
  fitnessStatus       String?
  fitnessFor          String[]  @default([])
  clearanceRemarks    String?
  clearanceIssuedAt   DateTime?
  course              Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  recordedByUser      User      @relation("MedExamRecordedBy", fields: [recordedBy], references: [id])
  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([studentId])
  @@index([courseId, visitDate])
  @@index([signToken])
  @@map("medical_exam_records")
}

model MedicineInventory {
  id                String          @id @default(cuid())
  courseId          String
  name              String
  unit              String
  stockQty          Int             @default(0)
  lowStockThreshold Int             @default(10)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  course            Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  usages            MedicineUsage[]

  @@index([courseId])
  @@map("medicine_inventory")
}

model MedicineUsage {
  id              String            @id @default(cuid())
  patientRecordId String
  medicineId      String
  medicineName    String
  quantityUsed    Int
  unit            String
  createdAt       DateTime          @default(now())
  medicine        MedicineInventory @relation(fields: [medicineId], references: [id])
  patientRecord   PatientRecord     @relation(fields: [patientRecordId], references: [id], onDelete: Cascade)

  @@index([patientRecordId])
  @@index([medicineId])
  @@map("medicine_usages")
}

model quiz_answers {
  id             String       @id
  questionId     String
  text           String
  correct        Boolean      @default(false)
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  quiz_questions QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model quiz_match_pairs {
  id             String       @id
  questionId     String
  left           String
  right          String
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  quiz_questions QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model repositories {
  id               String           @id
  name             String
  assignmentId     String           @unique
  courseId         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  activity_logs    ActivityLog[]
  assignments      Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  repository_files RepositoryFile[]
}

model verification_tokens {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GuidanceInfoSheet {
  id       String @id @default(cuid())
  courseId String

  // Header
  studentNo     String
  courseProgram String?
  yearSection   String?

  // Personal Info
  name            String
  nickname        String?
  age             Int?
  dateOfBirth     String?
  placeOfBirth    String?
  birthOrder      String?
  mobileNo        String?
  email           String?
  sex             String?
  religion        String?
  completeAddress String?

  // Parents — Father
  fatherName        String?
  fatherDOB         String?
  fatherAddress     String?
  fatherContact     String?
  fatherEduc        String?
  fatherOccupation  String?
  fatherIncome      String?
  fatherLanguage    String?
  fatherReligion    String?
  fatherOFW         String?
  fatherYearsAbroad String?

  // Parents — Mother
  motherName        String?
  motherDOB         String?
  motherAddress     String?
  motherContact     String?
  motherEduc        String?
  motherOccupation  String?
  motherIncome      String?
  motherLanguage    String?
  motherReligion    String?
  motherOFW         String?
  motherYearsAbroad String?

  // Marital Status
  maritalStatus String?

  // Siblings (stored as JSON array)
  siblings Json? @default("[]")

  // Guardian
  guardianName     String?
  guardianContact  String?
  guardianAddress  String?
  emergencyPerson  String?
  emergencyContact String?

  // Educational Background (stored as JSON)
  educBackground Json? @default("{}")

  // Awards & Organizations
  awards        String?
  organizations Json?   @default("[]")

  // Unique Features
  interests       String?
  talents         String?
  hobbies         String?
  goals           String?
  principles      String?
  characteristics String?
  fears           String?

  // Health Info
  healthAcademics       String?
  healthExtracurricular String?
  psychiatricHelp       String?
  counseling            String?

  // Photo & Signature
  photoUrl     String?
  signatureUrl String?
  signedAt     DateTime?

  // Status
  status        String   @default("SUBMITTED")
  allowResubmit Boolean  @default(false)
  submittedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentNo])
  @@index([courseId])
  @@map("guidance_info_sheets")
}

model GuidanceLogEntry {
  id                 String    @id @default(cuid())
  courseId           String
  name               String
  department         String?
  sex                String?
  purpose            String    @default("Counseling")
  email              String?
  signatureUrl       String?
  signatureMethod    String?
  signedAt           DateTime?
  signToken          String?   @unique
  signTokenExpiresAt DateTime?
  signEmailSentAt    DateTime?
  visitDate          DateTime  @default(now())
  recordedBy         String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  course         Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  recordedByUser User   @relation("GuidanceLogRecordedBy", fields: [recordedBy], references: [id])

  @@index([courseId])
  @@index([courseId, visitDate])
  @@index([signToken])
  @@map("guidance_log_entries")
}

model ExitInterview {
  id       String @id @default(cuid())
  courseId String

  // Personal Info
  studentNo       String?
  lastName        String
  firstName       String
  middleName      String?
  programSection  String?
  mobileNo        String?
  graduationMonth String?
  campus          String?
  homeAddress     String?
  email           String?
  sex             String?
  age             Int?
  dateOfBirth     String?

  // Feelings (Q1)
  feelHappy      Boolean @default(false)
  feelExcited    Boolean @default(false)
  feelSad        Boolean @default(false)
  feelNervous    Boolean @default(false)
  feelChallenged Boolean @default(false)
  feelOthers     String?

  // Influence (Q2)
  influenceProfessor Boolean @default(false)
  influenceClassmate Boolean @default(false)
  influenceFriends   Boolean @default(false)
  influenceFamily    Boolean @default(false)
  influenceOthers    String?

  // Plans (Q3)
  planFindJob     Boolean @default(false)
  planGradStudies Boolean @default(false)
  planBoardExam   Boolean @default(false)
  planOthers      Boolean @default(false)

  // Open-ended
  honorianValues         String?
  pressingProblemDetails Json?   @default("{}")
  likedMost              String?
  likedLeast             String?
  recommend              String?
  suggestions            String?

  // Counselor
  counselorNotes        String?
  counselorName         String?
  counselorSignatureUrl String?
  counselorSignedAt     DateTime?
  counselorId           String?

  // Student Signature
  studentSignatureUrl String?
  studentSignedAt     DateTime?

  // Photo
  photoUrl String?

  // Status
  status      String   @default("SUBMITTED")
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  counselor User?  @relation("ExitInterviewCounselor", fields: [counselorId], references: [id])

  @@index([courseId])
  @@map("exit_interviews")
}

model LibraryCardRequest {
  id       String @id @default(cuid())
  courseId String

  // Type
  requestType   String // "STUDENT_NEW" | "STUDENT_LOST" | "EMPLOYEE"
  applicantType String // "STUDENT" | "EMPLOYEE"
  cardType      String // "NEW" | "LOST" | "RENEW"

  // Employee type (for EMPLOYEE requests)
  employeeType String? // "Academic Personnel" | "Academic-Related Personnel" | "Non-Academic Personnel"

  // Common fields
  name      String
  sex       String?
  address   String?
  contactNo String?
  email     String?
  reason    String? // for lost card

  // Student-specific
  studentNo     String?
  courseProgram String?
  yearSection   String?

  // Employee-specific
  employeeNo  String?
  collegeDept String?
  position    String?

  // Photo
  photoUrl String? // passport size (student) or 1x1 (employee)

  // Affidavit (for lost card)
  affidavitUrl String?

  // COR / Validated ID (Student New)
  corIdUrl String?

  // Director / Head Librarian signature (Step 3)
  directorSignatureUrl String?
  directorSignedAt     DateTime?
  directorName         String?

  // Recipient signature on receiving log
  recipientSignatureUrl String?
  recipientSignedAt     DateTime?

  // Status flow
  status String @default("PENDING")
  // PENDING → PROCESSING → READY → RELEASED

  // Timestamps
  dateFiled   DateTime  @default(now())
  releasedAt  DateTime?
  submittedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  receivingLog LibraryReceivingLog?

  @@index([courseId])
  @@index([courseId, status])
  @@map("library_card_requests")
}

model LibraryReceivingLog {
  id        String  @id @default(cuid())
  courseId  String
  requestId String? @unique

  // Person info (copied from request or manual)
  name              String
  sex               String?
  courseYearSection String? // for students
  collegeDept       String? // for employees
  position          String? // for employees
  dateReceived      DateTime @default(now())
  documentReceived  String   @default("Library Card")

  // Signature
  signatureUrl       String?
  signatureMethod    String?
  signedAt           DateTime?
  signToken          String?   @unique
  signTokenExpiresAt DateTime?
  signEmailSentAt    DateTime?

  releasedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  request LibraryCardRequest? @relation(fields: [requestId], references: [id])

  @@index([courseId])
  @@index([signToken])
  @@map("library_receiving_logs")
}

model LibraryBook {
  id       String @id @default(cuid())
  courseId String

  // Identification
  accessionNo String
  callNumber  String?
  isbn        String?

  // Book details
  title         String
  author        String?
  publisher     String?
  copyrightYear String?
  edition       String?
  pages         Int?
  volume        String?

  // Classification
  category String // "Filipiniana" | "Circulation" | "Reserved" | "General References"
  location String?

  // Copies
  totalCopies     Int @default(1)
  availableCopies Int @default(1)

  // Cover
  coverUrl String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course        Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  borrowRecords LibraryBorrowRecord[]

  @@unique([courseId, accessionNo])
  @@index([courseId])
  @@index([courseId, category])
  @@map("library_books")
}

model LibraryBorrowRecord {
  id       String @id @default(cuid())
  courseId String
  bookId   String

  // Borrower info
  borrowerType   String // "STUDENT" | "EMPLOYEE" | "WALK_IN"
  borrowerId     String? // matched user id from system (optional)
  borrowerNo     String? // student no or employee no
  borrowerName   String
  borrowerCourse String?
  borrowerDept   String?

  // Borrow details
  borrowedAt DateTime  @default(now())
  dueDate    DateTime
  returnedAt DateTime?

  // Status
  status String @default("BORROWED") // "BORROWED" | "RETURNED" | "OVERDUE"

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  book   LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([bookId])
  @@index([courseId, status])
  @@index([borrowerNo])
  @@map("library_borrow_records")
}

